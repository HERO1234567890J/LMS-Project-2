# =============================================================================
# متغيرات بيئة منصة LMS
# =============================================================================
# ⚠️ ملاحظة مهمة: التطبيق لا يقرأ `.env` تلقائيًا (لا توجد مكتبة dotenv).
#    هذا الملف مرجع للقيم المطلوبة فقط. مرّرها للتطبيق عبر آلية التشغيل
#    اللي تختارها (systemd EnvironmentFile، Docker --env-file، pm2 ecosystem،
#    nginx-proxy مع passenger، أو أي طريقة CI/CD).
#
# للاستخدام المحلي السريع (تطوير فقط):
#     export $(grep -v '^#' .env | xargs)
#     npm start
#
# للإنتاج: لا تنشئ `.env` على السيرفر. مرّر القيم مباشرة عبر systemd / Docker.
# =============================================================================


# -----------------------------------------------------------------------------
# ① بيئة التشغيل
# -----------------------------------------------------------------------------
#   يُحدّد ما إذا كان التطبيق في وضع الإنتاج.
#   - "production"  → يُفعِّل cookie.secure, HSTS، يرفض البدء بدون SESSION_SECRET
#   - "development" (أو فارغ) → يستخدم السِّر الافتراضي + رسالة تحذير
# -----------------------------------------------------------------------------
NODE_ENV=production


# -----------------------------------------------------------------------------
# ② سر توقيع الجلسات (مطلوب في الإنتاج)
# -----------------------------------------------------------------------------
#   مفتاح عشوائي قوي (يفضّل ≥ 32 حرف) يُستخدم لتوقيع كوكيز الجلسات.
#   ولّد قيمة قوية بأحد الأوامر:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#     openssl rand -base64 48
#   ⚠️ تغيير هذا السر يُلغي كل الجلسات الحالية (الجميع يطلب تسجيل دخول جديد).
# -----------------------------------------------------------------------------
SESSION_SECRET=


# -----------------------------------------------------------------------------
# ③ المنفذ (Port)
# -----------------------------------------------------------------------------
#   المنفذ الذي يستمع عليه Express. الافتراضي 8000.
#   في الإنتاج عادةً ما يكون داخل reverse proxy ويترك 8000.
# -----------------------------------------------------------------------------
PORT=8000


# -----------------------------------------------------------------------------
# ④ رابط الموقع (مهم لـ SEO + رسائل البريد)
# -----------------------------------------------------------------------------
#   الـ URL الأساسي الذي يظهر في:
#   - canonical و og:url في صفحات SEO (/course/:id)
#   - لا يُستخدم في البريد (انظر PUBLIC_BASE_URL أدناه)
#   أمثلة:
#     SITE_URL=https://lms.example.com
#     SITE_URL=https://courses.example.org
# -----------------------------------------------------------------------------
SITE_URL=https://your-domain.com


# -----------------------------------------------------------------------------
# ⑤ رابط البريد (Base URL for password-reset emails)
# -----------------------------------------------------------------------------
#   الـ URL الذي يُدرج في رابط إعادة تعيين كلمة المرور المُرسل للطالب.
#   اتركه فارغًا لاستخدام الطلب الحالي (request.protocol + host) — مناسب في الإنتاج
#   خلف reverse proxy قد لا يمرّر الـ Host header بشكل صحيح.
#   مثال: PUBLIC_BASE_URL=https://lms.example.com
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# ⑥ فاصل مجدول النشر (بالـ مللي ثانية)
# -----------------------------------------------------------------------------
#   كم مرة يفحص مجدول المحتوى المجدول للنشر (publish_at <= now).
#   الافتراضي 60000 = 60 ثانية.
#   في الإنتاج يمكن تخفيضه إلى 15000 (15 ثانية) لو أردت نشرًا أسرع.
# -----------------------------------------------------------------------------
PUBLISH_SCHEDULER_INTERVAL_MS=60000


# -----------------------------------------------------------------------------
# ⑦ Bunny Stream (اختياري) — رفع فيديوهات المحاضرات على Bunny بدل التخزين المحلي
# -----------------------------------------------------------------------------
#   لو الاتنين متظبطين، أي فيديو محاضرة بيترفع هيتبعت لـ Bunny وهيتشغل بـ iframe
#   embed بدل ما يتخزن في backend/uploads. سيبهم فاضيين عشان يفضل يشتغل بالتخزين
#   المحلي زي ما هو دلوقتي.
#   - BUNNY_STREAM_LIBRARY_ID: رقم الـ Video Library من لوحة تحكم Bunny.
#   - BUNNY_STREAM_API_KEY: الـ Access Key الخاص بنفس المكتبة (مش مفتاح الحساب العام).
# -----------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
