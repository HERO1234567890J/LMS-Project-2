NODE_ENV=development
PORT=3000

# Postgres connection string. Create the database first (e.g. `createdb law_lms`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/law_lms"

# Signs the express-session cookie. Required in production (the app falls back to an
# insecure default otherwise) — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-this-session-secret-in-production

# Max upload size in bytes for lecture videos/files/covers (multer). Default: 100MB.
MAX_UPLOAD_BYTES=104857600

# Max upload size in bytes specifically for the /lessons/:id/video route (buffered in
# memory before being sent to Bunny, or written to disk if Bunny isn't configured).
# Default: 2GB.
MAX_VIDEO_UPLOAD_BYTES=2147483648

# Bunny Stream (video.bunnycdn.com) — optional. If both are set, lecture video uploads
# are sent to Bunny and played back via an embed iframe instead of local disk storage.
# Leave empty to keep using the local /uploads folder fallback.
#   BUNNY_STREAM_LIBRARY_ID -> the numeric Video Library ID
#   BUNNY_STREAM_API_KEY    -> that library's Access Key (Library API key, not the account key)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# Optional overrides consumed only by scripts/seed.js when seeding the single admin account.
# ADMIN_PHONE=01000000000
# ADMIN_EMAIL=admin@law-lms.local
# ADMIN_PASSWORD=Admin@12345
